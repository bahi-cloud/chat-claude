
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>منصة الذكاء الفائقة 2026 - Compact Enterprise OS</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Readex+Pro:wght@200;300;400;500;600;700;800&family=Space+Grotesk:wght@400;600;700&display=swap');

    :root {
      --bg-dark: #05070c;
      --panel-bg: rgba(13, 17, 28, 0.75);
      --panel-border: rgba(255, 255, 255, 0.08);
      --panel-hover: rgba(255, 255, 255, 0.12);
      
      --accent-cyan: #00f2fe;
      --accent-purple: #9d4edd;
      --accent-pink: #f72585;
      --accent-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #d946ef 100%);
      --accent-glow: rgba(124, 58, 237, 0.35);
      
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      
      /* Compact Dimension Standards */
      --sidebar-width: 220px;
      --sidebar-collapsed-width: 70px;
      --header-height: 52px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Readex Pro', system-ui, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(at 0% 0%, rgba(79, 70, 229, 0.15) 0px, transparent 40%),
        radial-gradient(at 100% 100%, rgba(217, 70, 239, 0.12) 0px, transparent 40%);
      color: var(--text-primary);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Ambient Glows */
    .ambient-glow {
      position: absolute;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: var(--accent-gradient);
      filter: blur(160px);
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
    }
    .glow-1 { top: -150px; right: -150px; }
    .glow-2 { bottom: -150px; left: -150px; }

    /* Compact Sidebar */
    .sidebar {
      width: var(--sidebar-width);
      background: var(--panel-bg);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border-left: 1px solid var(--panel-border);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 0.85rem 0.75rem;
      z-index: 10;
      transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }

    .sidebar.collapsed {
      width: var(--sidebar-collapsed-width);
    }

    .brand-container {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.25rem 0.4rem 0.85rem 0.4rem;
      border-bottom: 1px solid var(--panel-border);
      margin-bottom: 1rem;
      overflow: hidden;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      background: var(--accent-gradient);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.1rem;
      flex-shrink: 0;
      box-shadow: 0 6px 18px var(--accent-glow);
    }

    .brand-info {
      white-space: nowrap;
      transition: opacity 0.2s ease;
    }

    .sidebar.collapsed .brand-info,
    .sidebar.collapsed .nav-label-text,
    .sidebar.collapsed .btn-text,
    .sidebar.collapsed .user-details {
      display: none;
    }

    .brand-info h1 {
      font-size: 0.95rem;
      font-weight: 800;
      background: linear-gradient(90deg, #ffffff, #cbd5e1);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-info span {
      font-size: 0.65rem;
      color: var(--accent-cyan);
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .nav-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-secondary);
      margin-bottom: 0.5rem;
      padding: 0 0.4rem;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav-menu {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 0.75rem;
      border: 1px solid var(--panel-border);
      background: rgba(255, 255, 255, 0.02);
      color: var(--text-secondary);
      border-radius: 12px;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      text-align: right;
    }

    .btn-content {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      white-space: nowrap;
    }

    .nav-btn i {
      font-size: 1.1rem;
      flex-shrink: 0;
    }

    .nav-btn .status-indicator {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
    }

    .sidebar.collapsed .status-indicator {
      display: none;
    }

    .nav-btn:hover {
      background: var(--panel-hover);
      color: var(--text-primary);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .nav-btn.active {
      background: var(--accent-gradient);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.3);
      box-shadow: 0 8px 20px var(--accent-glow);
    }

    .nav-btn.active .status-indicator {
      background: #10b981;
      box-shadow: 0 0 8px #10b981;
    }

    /* Compact Telemetry */
    .metrics-panel {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid var(--panel-border);
      border-radius: 12px;
      padding: 0.65rem;
      margin-top: auto;
      margin-bottom: 0.65rem;
    }

    .sidebar.collapsed .metrics-panel {
      display: none;
    }

    .metric-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.72rem;
    }

    .metric-value {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      color: var(--accent-cyan);
    }

    .progress-bar-bg {
      width: 100%;
      height: 3px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 3px;
      overflow: hidden;
      margin-top: 0.25rem;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--accent-gradient);
      width: 34.2%;
    }

    /* User Compact Card */
    .user-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--panel-border);
      border-radius: 12px;
      padding: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: linear-gradient(135deg, #10b981, #059669);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.75rem;
      color: white;
      flex-shrink: 0;
    }

    /* Main Area Framework */
    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 1;
    }

    /* Top Navigation Compact Header */
    .top-bar {
      height: var(--header-height);
      border-bottom: 1px solid var(--panel-border);
      background: var(--panel-bg);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.25rem;
    }

    .page-title-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .toggle-sidebar-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--panel-border);
      color: var(--text-primary);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .toggle-sidebar-btn:hover {
      background: var(--panel-hover);
      color: var(--accent-cyan);
    }

    .page-title-text h2 {
      font-size: 0.95rem;
      font-weight: 700;
    }

    .controls-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .control-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--panel-border);
      color: var(--text-secondary);
      padding: 0.35rem 0.65rem;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s ease;
    }

    .control-btn:hover {
      background: var(--panel-hover);
      color: var(--text-primary);
    }

    /* Full Frame Target Display Area */
    .view-container {
      flex: 1;
      width: 100%;
      height: calc(100vh - var(--header-height));
      position: relative;
    }

    .app-frame {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
      background: transparent;
    }

    .frame-loader {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--bg-dark);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      z-index: 5;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .frame-loader.active {
      opacity: 1;
      pointer-events: all;
    }

    .spinner {
      width: 32px;
      height: 32px;
      border: 3px solid rgba(255, 255, 255, 0.1);
      border-top-color: var(--accent-cyan);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <div class="ambient-glow glow-1"></div>
  <div class="ambient-glow glow-2"></div>

  <!-- Sidebar Component -->
  <aside class="sidebar" id="sidebar">
    <div>
      <div class="brand-container">
        <div class="brand-logo">
          <i class="fa-solid fa-atom"></i>
        </div>
        <div class="brand-info">
          <h1>منصة الذكاء</h1>
          <span>AI OS 2026</span>
        </div>
      </div>

      <div class="nav-label">
        <span class="nav-label-text">الخدمات</span>
      </div>
      
      <ul class="nav-menu">
        <li>
          <button id="btn-chat" class="nav-btn active" onclick="loadService('chat', 'https://bahi-cloud.github.io/pro-max-problem/', 'الوكيل الذكي العام')">
            <div class="btn-content">
              <i class="fa-solid fa-brain" style="color: #00f2fe;"></i>
              <span class="btn-text">الوكيل الذكي العام</span>
            </div>
            <span class="status-indicator"></span>
          </button>
        </li>
        <li>
          <button id="btn-saha" class="nav-btn" onclick="loadService('saha', 'https://bahi-cloud.github.io/ni9ach-pro-max/', 'ساحة النقاش العبقرية')">
            <div class="btn-content">
              <i class="fa-solid fa-network-wired" style="color: #d946ef;"></i>
              <span class="btn-text">ساحة النقاش العبقرية</span>
            </div>
            <span class="status-indicator"></span>
          </button>
        </li>
      </ul>
    </div>

    <div class="metrics-panel">
      <div class="metric-row">
        <span><i class="fa-solid fa-microchip"></i> المعالجة</span>
        <span class="metric-value" id="cpuMetric">34.2%</span>
      </div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="cpuBar"></div>
      </div>
    </div>

    <div class="user-card">
      <div class="user-avatar">PRO</div>
      <div class="user-details" style="font-size:0.75rem;">
        <div style="font-weight:700;">المؤسسة الذكية</div>
        <div style="color:#10b981; font-size:0.65rem;">نشط الأن</div>
      </div>
    </div>
  </aside>

  <!-- Main View Area -->
  <main class="main-wrapper">
    <header class="top-bar">
      <div class="page-title-group">
        <button class="toggle-sidebar-btn" onclick="toggleSidebar()" title="تصغير/توسيع القائمة">
          <i class="fa-solid fa-bars-staggered"></i>
        </button>
        <div class="page-title-text">
          <h2 id="currentTitle">الوكيل الذكي العام</h2>
        </div>
      </div>

      <div class="controls-group">
        <button class="control-btn" onclick="reloadCurrentFrame()">
          <i class="fa-solid fa-rotate-right"></i>
          <span>تحديث</span>
        </button>
        <button class="control-btn" onclick="toggleFullScreen()">
          <i class="fa-solid fa-expand"></i>
          <span>ملء الشاشة</span>
        </button>
      </div>
    </header>

    <section class="view-container">
      <div id="frameLoader" class="frame-loader">
        <div class="spinner"></div>
      </div>
      <iframe id="serviceFrame" class="app-frame" src="https://bahi-cloud.github.io/pro-max-problem/" title="المحتوى المستدعى"></iframe>
    </section>
  </main>

  <script>
    let activeService = 'chat';

    function loadService(serviceKey, targetUrl, titleText) {
      if (activeService === serviceKey) return;
      activeService = serviceKey;

      const frame = document.getElementById('serviceFrame');
      const loader = document.getElementById('frameLoader');
      const btnChat = document.getElementById('btn-chat');
      const btnSaha = document.getElementById('btn-saha');
      const headerTitle = document.getElementById('currentTitle');

      loader.classList.add('active');

      if (serviceKey === 'chat') {
        btnChat.classList.add('active');
        btnSaha.classList.remove('active');
      } else {
        btnSaha.classList.add('active');
        btnChat.classList.remove('active');
      }

      headerTitle.innerText = titleText;
      frame.src = targetUrl;

      frame.onload = () => {
        loader.classList.remove('active');
      };
    }

    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('collapsed');
    }

    function reloadCurrentFrame() {
      const frame = document.getElementById('serviceFrame');
      const loader = document.getElementById('frameLoader');
      loader.classList.add('active');
      frame.src = frame.src;
      frame.onload = () => loader.classList.remove('active');
    }

    function toggleFullScreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen();
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
      }
    }

    setInterval(() => {
      const cpuVal = (25 + Math.random() * 12).toFixed(1);
      document.getElementById('cpuMetric').innerText = `${cpuVal}%`;
      document.getElementById('cpuBar').style.width = `${cpuVal}%`;
    }, 3000);
  </script>
</body>
</html>
